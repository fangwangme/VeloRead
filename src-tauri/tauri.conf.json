{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VeloRead",
  "version": "0.1.0",
  "identifier": "me.fangwang.veloread",
  "build": {
    "frontendDist": "../.local/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "VeloRead",
        "width": 1200,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 720,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Reference",
    "shortDescription": "EPUB reader with a speed-reading pacer",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
