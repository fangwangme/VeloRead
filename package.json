{
  "name": "veloread",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "fixture": "bun run scripts/make-fixture-epub.ts",
    "dict:import": "cargo run --release --manifest-path src-tauri/Cargo.toml --example dict-import --",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "bun run scripts/build-app.ts",
    "app:build:universal": "bun run scripts/build-app.ts -- --universal",
    "app:install": "bun run scripts/install-app.ts",
    "clean": "rm -rf .local/dist .local/release",
    "clean:all": "rm -rf .local/dist .local/release .local/target"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.16",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
